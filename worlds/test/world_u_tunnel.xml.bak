<mujoco model="Agilex Bunker">
  <compiler angle="radian" meshdir="../../bunker" coordinate="local" autolimits="true"/>
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker"></default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <include file="../../bunker/bunker_assests.xml"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <include file="../../bunker/bunker_body.xml"/>

    <body name="mid_goal_marker"   pos="0 0 0.1" mocap="true">
      <site name="mid_goal_sphere"   type="sphere" size="0.15" rgba="1 1 0 1"/>
    </body>
    <body name="final_goal_marker" pos="0 0 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.15" rgba="1 0 0 1"/>
    </body>

    <!--
    ═══════════════════════════════════════════════════════════════
    ĐƯỜNG HẦM CHỮ U  —  World 15x15m, bounds [-4,11] x [-4,11]

    Layout (top-down):

      x:  0   1.6  3.2  4.8  6.4
          │    │    │    │    │
    y=10  ┤    │    │    │    ┤   ← đỉnh tường (miệng hầm)
          │    │    │    │    │
    y=3   ┤    └────┘    └────┘   ← đáy U (tường ngang)
          └────────────────────   ← sàn ngoài

    Cánh TRÁI:
      Tường ngoài: x=0.0,  dày=0.3, cao từ y=3..10
      Tường trong: x=1.9,  dày=0.3, cao từ y=3..10
      Lòng trái:   x=0.3..1.9  rộng 1.6m ← đủ cho robot (bán kính 0.4m)

    Cánh PHẢI:
      Tường trong: x=3.8,  dày=0.3, cao từ y=3..10
      Tường ngoài: x=5.7,  dày=0.3, cao từ y=3..10
      Lòng phải:   x=4.1..5.7 rộng 1.6m

    Đáy U (ngang):
      Đáy ngoài:   y=3.0,  dày=0.3, từ x=0..6
      Đáy trong:   y=4.6,  dày=0.3, từ x=1.9..3.8  ← tạo vách ngăn đáy

    Kết nối đáy (góc):
      Góc dưới trái: nối tường ngoài trái với đáy ngoài
      Góc dưới phải: nối tường ngoài phải với đáy ngoài

    Robot START: (1.1, 9.0) — giữa lòng cánh TRÁI, gần trên
    GOAL:        (4.9, 9.0) — giữa lòng cánh PHẢI, gần trên
    ═══════════════════════════════════════════════════════════════
    -->

    <!-- ══ CÁNH TRÁI ══════════════════════════════════════════════ -->

    <!-- Tường NGOÀI trái: x=0.0, dày 0.3m, từ y=2.7 đến y=10.3 -->
    <body name="obstacle_TN0" pos="0.15 5.5 0.5">
      <geom type="box" size="0.15 2.0 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_TN1" pos="0.15 9.0 0.5">
      <geom type="box" size="0.15 1.8 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_TN2" pos="0.15 3.2 0.5">
      <geom type="box" size="0.15 1.0 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- Tường TRONG trái: x=1.9, dày 0.3m, từ y=4.6 đến y=10.3 -->
    <body name="obstacle_TT0" pos="2.05 7.0 0.5">
      <geom type="box" size="0.15 3.2 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_TT1" pos="2.05 9.8 0.5">
      <geom type="box" size="0.15 0.5 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ══ CÁNH PHẢI ══════════════════════════════════════════════ -->

    <!-- Tường TRONG phải: x=3.8, dày 0.3m, từ y=4.6 đến y=10.3 -->
    <body name="obstacle_PT0" pos="3.95 7.0 0.5">
      <geom type="box" size="0.15 3.2 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_PT1" pos="3.95 9.8 0.5">
      <geom type="box" size="0.15 0.5 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- Tường NGOÀI phải: x=5.7, dày 0.3m, từ y=2.7 đến y=10.3 -->
    <body name="obstacle_PN0" pos="5.85 5.5 0.5">
      <geom type="box" size="0.15 2.0 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_PN1" pos="5.85 9.0 0.5">
      <geom type="box" size="0.15 1.8 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_PN2" pos="5.85 3.2 0.5">
      <geom type="box" size="0.15 1.0 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ══ ĐÁY NGOÀI (ngang, toàn bộ chiều rộng) ══════════════════ -->
    <!-- y=2.7, từ x=0 đến x=6 -->
    <body name="obstacle_DN0" pos="1.5 2.85 0.5">
      <geom type="box" size="1.50 0.15 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_DN1" pos="4.5 2.85 0.5">
      <geom type="box" size="1.50 0.15 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ══ ĐÁY TRONG (vách ngăn giữa 2 cánh, y=4.6) ══════════════ -->
    <!-- Từ x=1.9 đến x=3.8 — tạo ra "đáy bên trong" đường hầm -->
    <body name="obstacle_DT0" pos="2.875 4.75 0.5">
      <geom type="box" size="0.875 0.15 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ══ GÓC NỐI (tường ngoài ↔ đáy ngoài) ══════════════════════ -->
    <!-- Góc dưới trái: (0.15, 2.85) -->
    <body name="obstacle_GL" pos="0.15 2.85 0.5">
      <geom type="box" size="0.15 0.15 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>
    <!-- Góc dưới phải: (5.85, 2.85) -->
    <body name="obstacle_GR" pos="5.85 2.85 0.5">
      <geom type="box" size="0.15 0.15 0.50" rgba="0.65 0.33 0.10 1"
            contype="1" conaffinity="1"/>
    </body>

  </worldbody>

  <include file="../../bunker/bunker_actuators.xml"/>
</mujoco>
