<mujoco model="Empty_Corridor_25m">

  <!-- ========================= -->
  <!-- COMPILER -->
  <!-- ========================= -->
  <compiler angle="radian" meshdir="../../mobile" coordinate="local" autolimits="true"/>

  <!-- ========================= -->
  <!-- OPTION -->
  <!-- ========================= -->
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <!-- ========================= -->
  <!-- VISUAL -->
  <!-- ========================= -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker">
    </default>
  </default>

  <!-- ========================= -->
  <!-- ASSET -->
  <!-- ========================= -->
  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>

    <texture type="2d" name="groundplane"
             builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>

    <include file="../../mobile/mobile_assets.xml"/>
  </asset>

  <!-- ========================= -->
  <!-- WORLD -->
  <!-- ========================= -->
  <include file="../../mobile/mobile_contacts.xml"/>
  <worldbody>
    <body name="mid_goal_marker" pos="10 0 0.1" mocap="true">
      <site name="mid_goal_sphere"
           type="sphere"
           size="0.2"
           rgba="1 1 0 1"/>
    </body>
    <body name="final_goal_marker" pos="23 0 0.1" mocap="true">
      <site name="final_goal_sphere"
        type="sphere"
        size="0.3"
        rgba="1 0 0 1"/>
    </body>
    <!-- LIGHT -->
    <light name="spotlight"
           mode="targetbodycom"
           target="mobile_base"
           pos="0 0 100"
           castshadow="false"/>

    <!-- FLOOR -->
    <geom name="floor"
          type="plane"
          size="0 0 0.05"
          material="groundplane"
          conaffinity="1"
          condim="3"/>

    <!-- ROBOT -->
    <include file="../../mobile/mobile_body.xml"/>

    <!-- ========================= -->
    <!-- WALLS -->
    <!-- ========================= -->
    <body name="wall_top" pos="12.5 5.3 0.5">
      <geom type="box" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1"/>
    </body>

    <body name="wall_bottom" pos="12.5 -5.3 0.5">
      <geom type="box" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1"/>
    </body>

    <body name="wall_start" pos="0 0 0.5">
      <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1"/>
    </body>

    <body name="wall_goal" pos="25 0 0.5">
      <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1"/>
    </body>

    <!-- ========================= -->
    <!-- OBSTACLES -->
    <!-- ========================= -->
    <body name="obstacle_0" pos="4 0 0.5">
      <geom type="box" size="0.65 0.65 0.5"
            rgba="1 0 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_1" pos="8 2.9 0.5">
      <geom type="box" size="0.5 1.5 0.5"
            rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="8 -2.9 0.5">
      <geom type="box" size="0.5 1.5 0.5"
            rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="12 -1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5"
            rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_4" pos="15 1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5"
            rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_5" pos="18 -1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5"
            rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_6" pos="21 1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5"
            rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <!-- ========================= -->
    <!-- GOAL -->
    <!-- ========================= -->
    <body name="goal" pos="23 0 0.1" mocap="true">
      <site name="goal_site"
            type="sphere"
            size="0.4"
            rgba="0 1 0 0.9"/>
    </body>

  </worldbody>

  <!-- ACTUATORS -->
  <include file="../../mobile/mobile_actuators.xml"/>

</mujoco>
