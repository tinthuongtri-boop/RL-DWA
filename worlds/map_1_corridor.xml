<mujoco model="Agilex Bunker">

  <!-- Compiler options -->
  <compiler angle="radian" meshdir="../../mobile" coordinate="local" autolimits="true"/>

  <!-- Integrator options -->
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <!-- Visual options -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker">
    </default>
  </default>

  <!-- Assets and textures definitions -->
  <asset>

    <!-- General scene meshes and materials -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <include file="../../mobile/mobile_assets.xml"/>

  </asset>

  <!-- Worldbody and bodies definitions -->
  <include file="../../mobile/mobile_contacts.xml"/>
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <include file="../../mobile/mobile_body.xml"/>

    <body name="mid_goal_marker" pos="23 0 0.1" mocap="true">
      <site name="mid_goal_sphere" type="sphere" size="0.1" rgba="1.0 1.0 0.0 1"/>
    </body>

    <body name="final_goal_marker" pos="23 0 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.1" rgba="1.0 0.0 0.0 1"/>
    </body>

    <!-- Walls — hanh lang 25x10.6 m -->
    <body name="wall_top" pos="12.5 5.3 0.5">
      <geom type="box" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>

    <body name="wall_bottom" pos="12.5 -5.3 0.5">
      <geom type="box" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>

    <body name="wall_start" pos="0 0 0.5">
      <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>

    <body name="wall_goal" pos="25 0 0.5">
      <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>

    <!-- Obstacles -->
    <body name="obstacle_0" pos="4 0 0.5">
      <geom type="box" size="0.65 0.65 0.5" rgba="1 0 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_1" pos="8 2.9 0.5">
      <geom type="box" size="0.5 1.5 0.5" rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="8 -2.9 0.5">
      <geom type="box" size="0.5 1.5 0.5" rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="12 -1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_4" pos="15 1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_5" pos="18 -1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_6" pos="21 1.2 0.5">
      <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

  </worldbody>

  <include file="../../mobile/mobile_actuators.xml"/>

</mujoco>
