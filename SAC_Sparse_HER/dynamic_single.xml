<mujoco model="RL_Curriculum_Corridor">

    <option timestep="0.01" gravity="0 0 -9.81"/>

    <visual>
        <headlight diffuse="0.7 0.7 0.7"
                   ambient="0.3 0.3 0.3"/>

        <global azimuth="135"
                elevation="-28"/>
    </visual>

    <worldbody>

        <!-- ================================================= -->
        <!-- FLOOR -->
        <!-- ================================================= -->

        <!-- Map: x = 0 -> 120 -->
        <geom name="floor"
              type="plane"
              pos="60 0 0"
              size="60 5 0.1"
              rgba="0.85 0.85 0.85 1"/>


        <!-- ================================================= -->
        <!-- WALLS -->
        <!-- ================================================= -->

        <!-- Top -->
        <geom type="box"
              pos="60 5.3 0.5"
              size="60 0.2 0.5"
              rgba="0.25 0.25 0.25 1"/>

        <!-- Bottom -->
        <geom type="box"
              pos="60 -5.3 0.5"
              size="60 0.2 0.5"
              rgba="0.25 0.25 0.25 1"/>

        <!-- Start -->
        <geom type="box"
              pos="0 0 0.5"
              size="0.2 5.3 0.5"
              rgba="0.25 0.25 0.25 1"/>

        <!-- End -->
        <geom type="box"
              pos="120 0 0.5"
              size="0.2 5.3 0.5"
              rgba="0.25 0.25 0.25 1"/>



        <!-- ================================================= -->
        <!-- ZONE 1 : EMPTY -->
        <!-- 0 -> 20 -->
        <!-- ================================================= -->



        <!-- ================================================= -->
        <!-- ZONE 2 : STATIC OBSTACLES -->
        <!-- 20 -> 40 -->
        <!-- ================================================= -->

        <geom type="box"
              pos="25 2.2 0.5"
              size="1 1 0.5"
              rgba="0.9 0.5 0 1"/>

        <geom type="box"
              pos="34 -2.2 0.5"
              size="1 1 0.5"
              rgba="0.9 0.5 0 1"/>



        <!-- ================================================= -->
        <!-- ZONE 3 : SINGLE SLOW DYNAMIC -->
        <!-- 40 -> 60 -->
        <!-- ================================================= -->

        <body name="slow_dyn"
              pos="50 0 0.45">

            <joint name="slow_joint"
                   type="slide"
                   axis="0 1 0"
                   range="-3.8 3.8"
                   damping="2"
                   limited="true"/>

            <geom type="box"
                  size="0.8 0.45 0.45"
                  mass="20"
                  rgba="1 0.2 0.2 1"/>

        </body>



        <!-- ================================================= -->
        <!-- ZONE 4 : MULTI DYNAMIC -->
        <!-- 60 -> 80 -->
        <!-- ================================================= -->

        <body name="fast_dyn1"
              pos="65 0 0.45">

            <joint name="fast_joint1"
                   type="slide"
                   axis="0 1 0"
                   range="-3.8 3.8"
                   damping="1.8"
                   limited="true"/>

            <geom type="box"
                  size="0.8 0.45 0.45"
                  mass="22"
                  rgba="1 0 0 1"/>

        </body>


        <body name="fast_dyn2"
              pos="75 0 0.45">

            <joint name="fast_joint2"
                   type="slide"
                   axis="0 1 0"
                   range="-3.8 3.8"
                   damping="1.8"
                   limited="true"/>

            <geom type="cylinder"
                  size="0.7 0.45"
                  mass="22"
                  rgba="1 0.3 0 1"/>

        </body>



        <!-- ================================================= -->
        <!-- ZONE 5 : NARROW PASSAGE -->
        <!-- 80 -> 100 -->
        <!-- ================================================= -->

        <!-- Upper wall -->
        <geom type="box"
              pos="90 3.8 0.5"
              size="5 1 0.5"
              rgba="0.2 0.2 0.8 1"/>

        <!-- Lower wall -->
        <geom type="box"
              pos="90 -3.8 0.5"
              size="5 1 0.5"
              rgba="0.2 0.2 0.8 1"/>



        <!-- ================================================= -->
        <!-- ZONE 6 : FINAL HARD ZONE -->
        <!-- STATIC + DYNAMIC -->
        <!-- 100 -> 120 -->
        <!-- ================================================= -->

        <!-- ===== STATIC BLOCKS ===== -->

        <geom type="box"
              pos="104 3 0.5"
              size="1.2 1.2 0.5"
              rgba="0.8 0.2 0.8 1"/>

        <geom type="box"
              pos="110 -3 0.5"
              size="1.2 1.2 0.5"
              rgba="0.8 0.2 0.8 1"/>

        <geom type="box"
              pos="116 0 0.5"
              size="1 1 0.5"
              rgba="0.7 0.1 0.7 1"/>



        <!-- ===== DYNAMIC 1 ===== -->
        <!-- Vertical movement -->

        <body name="cross_vertical"
              pos="106 0 0.45">

            <joint name="cross_y"
                   type="slide"
                   axis="0 1 0"
                   range="-3.8 3.8"
                   damping="1.5"
                   limited="true"/>

            <geom type="box"
                  size="0.8 0.5 0.45"
                  mass="25"
                  rgba="1 0 0 1"/>

        </body>



        <!-- ===== DYNAMIC 2 ===== -->
        <!-- Horizontal movement -->

        <body name="cross_horizontal"
              pos="114 0 0.45">

            <joint name="cross_x"
                   type="slide"
                   axis="1 0 0"
                   range="110 118"
                   damping="1.5"
                   limited="true"/>

            <geom type="box"
                  size="0.8 0.5 0.45"
                  mass="25"
                  rgba="0 1 0 1"/>

        </body>



        <!-- ================================================= -->
        <!-- GOAL -->
        <!-- ================================================= -->

        <body name="goal"
              pos="118 0 0.1"
              mocap="true">

            <site name="goal_site"
                  type="sphere"
                  size="0.5"
                  rgba="0 1 0 0.9"/>

        </body>

    </worldbody>



    <!-- ================================================= -->
    <!-- ACTUATORS -->
    <!-- ================================================= -->

    <actuator>

        <!-- Zone 3 -->
        <position name="slow_ctrl"
                  joint="slow_joint"
                  kp="500"
                  kv="90"
                  ctrlrange="-3.8 3.8"/>

        <!-- Zone 4 -->
        <position name="fast_ctrl1"
                  joint="fast_joint1"
                  kp="550"
                  kv="95"
                  ctrlrange="-3.8 3.8"/>

        <position name="fast_ctrl2"
                  joint="fast_joint2"
                  kp="550"
                  kv="95"
                  ctrlrange="-3.8 3.8"/>

        <!-- Zone 6 -->
        <position name="cross_y_ctrl"
                  joint="cross_y"
                  kp="600"
                  kv="100"
                  ctrlrange="-3.8 3.8"/>

        <position name="cross_x_ctrl"
                  joint="cross_x"
                  kp="600"
                  kv="100"
                  ctrlrange="110 118"/>

    </actuator>

</mujoco>