<mujoco model="Empty_Corridor2_25m">

  <!-- ========================= -->
  <!-- COMPILER + OPTION -->
  <!-- ========================= -->
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option timestep="0.01" cone="elliptic" integrator="RK4" gravity="0 0 -9.81"/>

  <!-- ========================= -->
  <!-- VISUAL STYLE (bunker style) -->
  <!-- ========================= -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.1 0.1 0.1"
               specular="0 0 0"/>

    <rgba haze="0.15 0.25 0.35 1"/>

    <global azimuth="135"
            elevation="-28"/>
  </visual>

  <!-- ========================= -->
  <!-- ASSETS (ground texture style giống bunker) -->
  <!-- ========================= -->
  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <texture type="2d"
             name="groundplane"
             builtin="checker"
             mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300"
             height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <!-- ========================= -->
  <!-- WORLD -->
  <!-- ========================= -->
  <worldbody>

    <!-- LIGHT -->
    <light name="spotlight"
           pos="0 0 100"
           mode="targetbodycom"
           target="goal"
           castshadow="false"/>

    <!-- FLOOR (giữ nguyên nhưng đổi style bunker) -->
    <geom name="floor"
          type="plane"
          pos="12.5 0 0"
          size="12.5 5 0.05"
          material="groundplane"
          conaffinity="1"
          condim="3"/>

        <!-- WALLS -->
        <geom type="box" pos="12.5 5.3 0.5" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1"/>
        <geom type="box" pos="12.5 -5.3 0.5" size="12.5 0.2 0.5" rgba="0.25 0.25 0.25 1"/>
        <geom type="box" pos="0 0 0.5" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1"/>
        <geom type="box" pos="25 0 0.5" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1"/>

        <!-- ========================= -->
        <!-- SAME OBSTACLES - SHUFFLED -->
        <!-- ========================= -->

        <!-- trước: mid left/right -> giờ chuyển lên đầu -->
        <geom type="box" pos="4  2.9 0.5" size="0.5 1.5 0.5" rgba="1 0.5 0 1"/>
        <geom type="box" pos="4 -2.9 0.5" size="0.5 1.5 0.5" rgba="1 0.5 0 1"/>

        <!-- trước: single center -> chuyển sang 9 -->
        <geom type="box" pos="7 0 0.5" size="0.65 0.65 0.5" rgba="1 0 0 1"/>

        <!-- trước: hard zone 16–28 -> giữ nhưng đổi pattern -->
        <geom type="box" pos="10  1.8 0.5" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1"/>
        <geom type="box" pos="13 -1.8 0.5" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1"/>
        <geom type="box" pos="16  1.8 0.5" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1"/>
        <geom type="box" pos="19 -1.8 0.5" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1"/>

        <!-- trước: cuối gần goal -> chuyển lên mid-late -->
        <geom type="box" pos="22 0 0.5" size="0.5 2.3 0.5" rgba="1 0 0 0.8"/>

        <!-- GOAL -->
        <body name="goal" pos="24 0 0.1" mocap="true">
            <site name="goal_site" type="sphere" size="0.4" rgba="0 1 0 0.9"/>
        </body>

    </worldbody>
</mujoco>