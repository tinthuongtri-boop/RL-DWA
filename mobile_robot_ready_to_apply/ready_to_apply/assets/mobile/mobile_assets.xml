<mujocoinclude>
    <!-- Mobile diff-drive robot: meshes and materials.

         NOTE ON SCALE (đã kiểm chứng bằng bounding-box + đối chiếu thông số
         Gazebo diff_drive_plugin gốc):
           - URDF gốc chỉ đặt scale="0.001 0.001 0.001" cho base_footprint.STL,
             nhưng bounding box của file này khi đọc trực tiếp đã là ~0.7 m
             (đúng kích thước thật) chứ không phải 700 m. Đây là lỗi/thừa số
             từ file URDF gốc (rất hay gặp khi export từ SolidWorks) -> KHÔNG
             áp dụng thêm scale nào ở đây.
           - Bằng chứng chéo: bán kính bánh chủ động đo được từ left_wheel.STL
             là 0.085 m (đường kính 0.17 m) và khoảng cách 2 tâm bánh
             (2*0.16297 = 0.326 m) khớp CHÍNH XÁC với
             <wheel_diameter>0.17</wheel_diameter> và
             <wheel_separation>0.326</wheel_separation> khai báo trong plugin
             libgazebo_ros_diff_drive.so của URDF gốc.
         => Toàn bộ mesh dùng scale mặc định (1 1 1). -->

    <material name="mobile_gray" rgba="0.79216 0.81961 0.93333 1"/>
    <material name="mobile_dark" rgba="0.08235 0.08235 0.08235 1"/>

    <mesh name="base_footprint" file="base_footprint.STL"/>
    <mesh name="base_link"      file="base_link.STL"/>
    <mesh name="left_wheel"     file="left_wheel.STL"/>
    <mesh name="right_wheel"    file="right_wheel.STL"/>
    <mesh name="laser"          file="laser.STL"/>
    <mesh name="imu"            file="imu.STL"/>
</mujocoinclude>
