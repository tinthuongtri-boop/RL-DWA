<mujoco model="Corridor_Map_2_Shuffled">
  <!-- CẤU HÌNH COMPILER VÀ RENDER TỪ FILE CHUẨN -->
  <compiler angle="radian" meshdir="../../mobile" coordinate="local" autolimits="true"/>
  <option timestep="0.01" cone="elliptic" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="agilex_bunker"></default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <include file="../../mobile/mobile_assets.xml"/>
  </asset>

  <include file="../../mobile/mobile_contacts.xml"/>
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="mobile_base" pos="0 0 100" castshadow="false"/>
    
    <!-- FLOOR (Chuyển sang dùng groundplane có lưới kẻ caro cho dễ nhìn) -->
    <geom conaffinity="1" condim="3" name="floor" pos="17.5 0 0" size="17.5 5 0.05" type="plane" material="groundplane"/>

    <!-- LOAD XE BUNKER VÀO BẢN ĐỒ -->
    <include file="../../mobile/mobile_body.xml"/>

    <!-- GOAL MARKERS BẮT BUỘC (Để Python không báo lỗi tìm ID) -->
    <body name="mid_goal_marker" pos="33 0 0.1" mocap="true">
      <site name="mid_goal_sphere" type="sphere" size="0.1" rgba="1.0 1.0 0.0 1"/>
    </body>
    <body name="final_goal_marker" pos="33 0 0.1" mocap="true">
      <site name="final_goal_sphere" type="sphere" size="0.4" rgba="0 1 0 0.9"/>
    </body>

    <!-- ========================= -->
    <!-- TƯỜNG BAO (WALLS) -->
    <!-- ========================= -->
    <body name="obstacle_wall_top" pos="17.5 5.3 0.5">
        <geom type="box" size="17.5 0.2 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_wall_bot" pos="17.5 -5.3 0.5">
        <geom type="box" size="17.5 0.2 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_wall_left" pos="0 0 0.5">
        <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_wall_right" pos="35 0 0.5">
        <geom type="box" size="0.2 5.3 0.5" rgba="0.25 0.25 0.25 1" contype="1" conaffinity="1"/>
    </body>

    <!-- ========================= -->
    <!-- VẬT CẢN (Đã bọc trong body name="obstacle_...") -->
    <!-- ========================= -->
    <body name="obstacle_0" pos="5 2.9 0.5">
        <geom type="box" size="0.5 1.5 0.5" rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_1" pos="5 -2.9 0.5">
        <geom type="box" size="0.5 1.5 0.5" rgba="1 0.5 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_2" pos="9 0 0.5">
        <geom type="box" size="0.65 0.65 0.5" rgba="1 0 0 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_3" pos="14 1.8 0.5">
        <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_4" pos="17 -1.8 0.5">
        <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_5" pos="20 1.8 0.5">
        <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>
    <body name="obstacle_6" pos="23 -1.8 0.5">
        <geom type="box" size="0.6 0.8 0.5" rgba="0.8 0 0.8 1" contype="1" conaffinity="1"/>
    </body>

    <body name="obstacle_7" pos="28 0 0.5">
        <geom type="box" size="0.5 2.3 0.5" rgba="1 0 0 0.8" contype="1" conaffinity="1"/>
    </body>

  </worldbody>

  <!-- LOAD ĐỘNG CƠ CỦA XE BUNKER -->
  <include file="../../mobile/mobile_actuators.xml"/>

</mujoco>
