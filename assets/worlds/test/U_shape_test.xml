<mujoco model="U_Shape_Corridor_Robot">

  <!-- ========================= -->
  <!-- COMPILER (giống bunker style) -->
  <!-- ========================= -->
  <compiler angle="radian"
            coordinate="local"
            autolimits="true"/>

  <!-- ========================= -->
  <!-- OPTIONS -->
  <!-- ========================= -->
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <!-- ========================= -->
  <!-- VISUAL -->
  <!-- ========================= -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.1 0.1 0.1"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130"
            elevation="-25"/>
  </visual>

  <!-- ========================= -->
  <!-- ASSETS (minimal like bunker) -->
  <!-- ========================= -->
  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512" height="3072"/>

    <texture type="2d" name="groundplane"
             builtin="checker"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             mark="edge"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <!-- ========================= -->
  <!-- WORLD -->
  <!-- ========================= -->
  <worldbody>

    <!-- LIGHT -->
    <light name="spotlight"
           mode="targetbodycom"
           pos="0 0 20"
           target="robot"
           castshadow="false"/>

    <!-- FLOOR (giữ U-shape của bạn) -->
    <geom name="floor"
          type="plane"
          pos="12 0 0"
          size="30 20 0.1"
          material="groundplane"/>

    <!-- ========================= -->
    <!-- ROBOT INCLUDE (THÊM VÀO) -->
    <!-- ========================= -->

    <!-- 👉 bạn thay path robot của bạn ở đây -->
    <include file="../../bunker/bunker_body.xml"/>

    <!-- ========================= -->
    <!-- GOAL -->
    <!-- ========================= -->
    <body name="goal"
          pos="22 6 0.2"
          mocap="true">
      <site name="goal_site"
            type="sphere"
            size="0.4"
            rgba="0 1 0 1"/>
    </body>

    <!-- ========================= -->
    <!-- U-SHAPE WALLS (GIỮ NGUYÊN BẢN CỦA BẠN) -->
    <!-- ========================= -->

    <!-- outer walls -->
    <geom type="box" pos="0 0 0.5" size="0.25 8 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="24 0 0.5" size="0.25 8 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="12 -8 0.5" size="12 0.25 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="2 8 0.5" size="2 0.25 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="22 8 0.5" size="2 0.25 0.5" rgba="0.2 0.2 0.2 1"/>

    <!-- inner walls -->
    <geom type="box" pos="4 0 0.5" size="0.25 4 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="20 0 0.5" size="0.25 4 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="12 -4 0.5" size="8 0.25 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="4 6 0.5" size="0.25 2 0.5" rgba="0.2 0.2 0.2 1"/>
    <geom type="box" pos="20 6 0.5" size="0.25 2 0.5" rgba="0.2 0.2 0.2 1"/>

  </worldbody>

  <!-- ========================= -->
  <!-- ACTUATORS (từ robot model) -->
  <!-- ========================= -->
  <include file="../../bunker/bunker_actuators.xml"/>

</mujoco>